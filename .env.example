# ── Router ────────────────────────────────────────────────────────────────────
# HTTP port for the router server.
ROUTER_PORT=8787

# Node environment: development | production | test
NODE_ENV=development

# ── ENS (Sepolia) ─────────────────────────────────────────────────────────────
# Sepolia JSON-RPC endpoint. Use your own provider (Infura/Alchemy) or a public one.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The ONLY ENS identity the router is configured with. The router reads the list
# of specialist agents from this name's "agents.directory" text record at runtime.
# Replace with a name you own on Sepolia.
ENS_DIRECTORY_NAME=agent-directory.your-ens-name.eth

# Optional override for the ENS Universal Resolver address on Sepolia
# (viem ships with a default: 0xeeeeeee e14d718c2b47d9923deab1335e144eeee).
ENS_UNIVERSAL_RESOLVER_ADDRESS=

# ENS writes (scripts/publish-agents.ts): the ENSv1 Sepolia registry
# (canonical ENS registry address). Only needed when publishing records.
ENS_REGISTRY_ADDRESS=0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e

# Wallet private key used ONLY by scripts/publish-agents.ts.
# NEVER commit a real key. Keep it in .env (gitignored) only.
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here

# ── LLM (OpenAI-compatible) ───────────────────────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint (OpenAI, OpenRouter, local, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_TIMEOUT_MS=15000

# ── Router behaviour ──────────────────────────────────────────────────────────
# Explicit timeout (ms) for every router -> specialist agent HTTP call.
AGENT_REQUEST_TIMEOUT_MS=8000

# Development exception: allow plain http:// for localhost/127.0.0.1 agent endpoints.
# Ignored (always off) when NODE_ENV=production — production ENS records must use HTTPS.
ALLOW_LOCALHOST_ENDPOINTS=true

# 0 (default) = discover fresh from ENS on every request. Set > 0 for a TTL cache (ms).
DISCOVERY_CACHE_TTL_MS=0

# ── Specialist agents (local development ports) ──────────────────────────────
CONTRACT_AGENT_PORT=8791
BRAND_AGENT_PORT=8792
INVOICE_AGENT_PORT=8793
